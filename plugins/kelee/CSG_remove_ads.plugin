[Rewrite]
response if ${url} ~= /^https:\/\/95598\.csg\.cn\/mp\/mpaas\/mgw\.htm$/i then response.json.jq("if .info | contains(\"RUBIK-TRACEID:\") then .scene.page.areas |= map(select(.areaId | test(\"kingkong_|9grid_|message_|nearmap_|recommend_\"))) else . end")

request if ${url} ~= /^https:\/\/95598\.csg\.cn\/mp\/ucs\/ma\/zt\/content\/queryHotInformations$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/95598\.csg\.cn\/mp\/mpaas\/rubik\/openapi\/rubik\/mobile\/getRubikScene$/i then reject_dict(200)

[MitM]
hostname=95598.csg.cn