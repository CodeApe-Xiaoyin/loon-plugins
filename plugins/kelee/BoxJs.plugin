#!date=2026-10-02 13:57:49

[Rule]
DOMAIN-SUFFIX, jsdelivr.net, PROXY

[Script]
request if ${url} ~= /^https?:\/\/(.+\.)?boxjs\.(com|net)/i then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js") with tag="BoxJS", timeout=120, requires_body=true

[MitM]
hostname=boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net