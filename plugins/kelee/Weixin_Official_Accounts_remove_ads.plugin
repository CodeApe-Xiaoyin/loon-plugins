#!name=微信公众号去广告
#!desc=过滤微信公众号广告
#!openUrl=https://apps.apple.com/app/id414478124
#!author=RuCu6[https://github.com/RuCu6]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weixin.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN-SUFFIX, wxs.qq.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword/i then reject_dict(200)


[MitM]
hostname=mp.weixin.qq.com