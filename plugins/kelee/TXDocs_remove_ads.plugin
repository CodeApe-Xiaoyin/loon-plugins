[Rewrite]
request if ${url} ~= /^https:\/\/tianshu\.qq\.com\/open\/ts_access\/GetAds\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/h5\.qzone\.qq\.com\/p\/adboss\/api\/json\/ts_access\/GetAds$/i then reject_dict(200)

[MitM]
hostname=tianshu.qq.com, h5.qzone.qq.com