[Script]
request if ${url} ~= /^https:\/\/apple-api\.com/i then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/IPATool/AppStoreAPI.js") with tag="App Store API", requires_body=true

request if ${url} ~= /^https:\/\/xiaobai\.app/i then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/IPATool/Installer.js") with tag="安装器"

[MitM]
hostname=apple-api.com, xiaobai.app