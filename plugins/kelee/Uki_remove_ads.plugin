[Rewrite]
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/startInfo$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/indexBanner$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/getPopup/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/allPopUpConfig$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/advConf$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/user\/checkQTSheInsurance$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/lover\/productList/i then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js") with tag="移除匹配卡横幅", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/closeFriend\/home/i then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js") with tag="移除密友横幅", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/party\/config$/i then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js") with tag="移除娱乐页面横幅和悬浮窗配置", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v1\/post\/fetchSearchRecommend$/i then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js") with tag="移除广场搜索填充词", requires_body=true

