#!name=TestFlight地区解锁
#!desc=解除TestFlight的区域限制，支持tvOS。
#!openUrl=https://apps.apple.com/app/id899247664
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=功能增强
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/kelee-snapshot-2026-11-10/vendor/kelee/resources/raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TestFlight.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, testflight.apple.com, PROXY

[Rewrite]
request if ${url} ~= /^https?:\/\/testflight\.apple\.com\/v\d\/accounts\/.+?\/install$/i then request.body.replace(/"storefrontId"\x20:\x20"\d{6}-\d{2},\d{2}",/, "\"storefrontId\":\"143441-19,29\",")

[MitM]
hostname=testflight.apple.com