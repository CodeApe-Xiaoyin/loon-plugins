# Based on https://github.com/Yu9191/Rewrite/blob/main/haijiao/haijiao.plugin
# Upstream author: Yu9191 Rewrite. Upstream build: 2026-08-22.
# Modified by 落痕 on 2026-11-15: 修复 Loon 上解锁失效、嵌套请求递归与 m3u8 线路主机不匹配。
# See docs/haijiao.md for attribution and version history.
#!name=海角视频解锁（修复版）
#!desc=v0.3.1 · 移除广告位、解锁付费与金币帖、还原 m3u8 解密 key。需登录账号。
#!author=Yu9191 Rewrite, 落痕
#!tag=18+,解锁
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/CodeApe-Xiaoyin/loon-plugins
#!date=2026-11-15

[Script]
# 接口响应改写：广告位置空、解锁字段写回、注入完整视频链接。
response if ${url} ~= /^https?:\/\/(www\.)?haijiao\.com\/api\/(banner\/banner_list|attachment|topic\/\d+)/ then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/main/scripts/haijiao.js") with requires_body=true, tag="海角·接口"

# m3u8 改写：把加密 key 还原后内联为 data URI，避免播放器取到加密 key。
response if ${url} ~= /^https?:\/\/[^\/]*\.hj\d+\.top\/.*\.m3u8$/ then script("https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/main/scripts/haijiao.js") with requires_body=true, tag="海角·m3u8"

[MitM]
hostname=haijiao.com, www.haijiao.com, *.hj260302818.top
