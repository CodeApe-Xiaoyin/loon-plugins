[Host]
# 基于 Yang（YanG-1989）咪咕源进行修复。源仓库：https://github.com/YanG-1989/m3u
# CDN 主机由咪咕调度返回，使用中国移动咪咕视频 CDN 的域名解析。
cache.ott.fifalive.itv.cmvideo.cn = base-v4v6-cm-miguvideo.e.cdn.chinamobile.com

[Script]
http-response ^http:\/\/gslbserv\.itv\.cmvideo\.cn\/index\.m3u8(?:\?|$) script-path=https://raw.githubusercontent.com/CodeApe-Xiaoyin/loon-plugins/main/scripts/Yang_migu_redirect.js,tag=Yang移动咪咕 302 重定向
